  }
  // Groups digits like the country's sample number ("081 234 5678"); the sample's trunk prefix is
  // left out when the shopper did not type one. Digits beyond the sample follow after a space.
  function group(c, d) {
    var ex = String(c.example || ""), exd = digits(ex);
    if (!d || !exd) return d;
    var lead = exd.length - national(c, exd).length;
    if (lead && d.slice(0, lead) !== exd.slice(0, lead)) {
      var seen = 0, i = 0;
      while (i < ex.length && seen < lead) { if (/\d/.test(ex.charAt(i))) seen++; i++; }
      ex = ex.slice(i).replace(/^[^\d(]+/, "");
    }
