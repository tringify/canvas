      li.id = st.ul.id + "-" + c.iso_code; li.className = "cv-phone__opt" + (c === st.cur ? " is-current" : "");
      li.setAttribute("role", "option"); li.setAttribute("aria-selected", "false"); li.setAttribute("data-iso", c.iso_code);
      var f = document.createElement("span"); f.className = "cv-phone__oflag"; f.setAttribute("aria-hidden", "true"); f.textContent = flagOf(c);
      var n = document.createElement("span"); n.className = "cv-phone__oname"; n.textContent = c.name;
      var dl = document.createElement("bdi"); dl.className = "cv-phone__odial"; dl.setAttribute("dir", "ltr"); dl.textContent = c.dial_code;
      li.appendChild(f); li.appendChild(n); li.appendChild(dl); frag.appendChild(li);
    });
    st.ul.replaceChildren(frag);
    st.root.querySelector("[data-cv-phone-none]").textContent = st.shown.length ? "" : st.root.querySelector("[data-cv-phone-none-text]").textContent;
    var at = raw ? 0 : st.shown.indexOf(st.cur);
    active(st, st.shown.length ? Math.max(0, at) : -1);
  }
  function active(st, i) {
    var opts = st.ul.children;
    st.at = i;
    for (var k = 0; k < opts.length; k++) { opts[k].setAttribute("aria-selected", k === i ? "true" : "false"); opts[k].classList.toggle("is-active", k === i); }
    if (i >= 0 && opts[i]) { st.q.setAttribute("aria-activedescendant", opts[i].id); opts[i].scrollIntoView({ block: "nearest" }); }
    else st.q.removeAttribute("aria-activedescendant");
  }
  // In the top layer the list is never clipped by a drawer or panel; it sits under the field, or above it when there is more room there.
  function place(st) {
    if (!TOP) return;
    var r = st.row.getBoundingClientRect(), vh = window.innerHeight, below = vh - r.bottom - 12, above = r.top - 12, up = below < 240 && above > below;
    // At least 300px wide in a narrow row (a cart line), kept inside the window and aligned to the field's start edge.
    var vw = document.documentElement.clientWidth, w = Math.min(Math.max(r.width, 300), vw - 16);
    var x = getComputedStyle(st.root).direction === "rtl" ? r.right - w : r.left, s = st.pop.style;
    s.left = Math.min(Math.max(8, x), vw - 8 - w) + "px"; s.width = w + "px";
    if (up) { s.top = "auto"; s.bottom = (vh - r.top + 6) + "px"; } else { s.bottom = "auto"; s.top = (r.bottom + 6) + "px"; }
    s.setProperty("--cv-phone-room", Math.max(140, (up ? above : below) - 80) + "px");
  }
  function isOpen(st) { return !!st && (TOP ? st.pop.matches(":popover-open") : !st.pop.hidden); }
  var openSt = null;
  function open(st) {
    if (openSt && openSt !== st) close(openSt, false);
    openSt = st; st.btn.setAttribute("aria-expanded", "true");
    if (TOP) { st.pop.showPopover(); place(st); } else st.pop.hidden = false;
