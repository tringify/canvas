    if (hint) { hint.textContent = c.example ? (root.getAttribute("data-label-example") || "").replace("__EX__", c.example) : ""; hint.hidden = !c.example; }
    if (c.example) st.num.setAttribute("placeholder", c.example); else st.num.removeAttribute("placeholder");
