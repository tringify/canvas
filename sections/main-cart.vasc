    for (var j = 0; j < ex.length && k < d.length; j++) out += /\d/.test(ex.charAt(j)) ? d.charAt(k++) : ex.charAt(j);
    return k < d.length ? out + " " + d.slice(k) : out;
  }
  // A national number as typed: digits only, within the country's length, grouped. The caret keeps
  // its place among the digits, so editing in the middle of the number works.
  function shape(st) {
    var el = st.num, v = String(el.value || "");
    if (/^\s*(\+|00)/.test(v)) { if (v.length > 20) el.value = v.slice(0, 20); return; }
    var at = el.selectionStart == null ? v.length : el.selectionStart;
    var before = digits(v.slice(0, at)).length, d = cap(st.cur, digits(v)), next = group(st.cur, d);
    if (next === v) return;
    el.value = next;
    var pos = 0, n = 0;
    while (pos < next.length && n < Math.min(before, d.length)) { if (/\d/.test(next.charAt(pos))) n++; pos++; }
    if (document.activeElement === el) el.setSelectionRange(pos, pos);
  }
  function value(st) {
    var s = String(st.num.value || "").trim(), compact = s.replace(/\(0\)/g, "").replace(/[^0-9+]/g, ""), d = digits(compact);
    if (!d) return "";
    if (compact.charAt(0) === "+") return "+" + d;
