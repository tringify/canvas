  function choose(st, c, focus) {
    st.cur = c;
    var root = st.root, label = (root.getAttribute("data-label-selected") || "").replace("__C__", c.name + " (" + c.dial_code + ")");
    root.querySelectorAll("[data-cv-phone-flag]").forEach(function (el) { el.textContent = flagOf(c); });
    root.querySelectorAll("[data-cv-phone-dial]").forEach(function (el) { el.textContent = c.dial_code; });
    root.querySelectorAll("[data-cv-phone-cc-label]").forEach(function (el) { el.textContent = label; });
