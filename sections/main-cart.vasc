    if (back) st.btn.focus();
  }
  function stOf(el) { var root = el && el.closest && el.closest("[data-cv-phone]"); return root ? setup(root) : null; }
  document.addEventListener("click", function (e) {
    var b = e.target.closest && e.target.closest("[data-cv-phone-cc]");
    if (b) { var st = stOf(b); if (st) { if (isOpen(st)) close(st, true); else open(st); } return; }
    var o = e.target.closest && e.target.closest(".cv-phone__opt");
    if (o) {
      var s2 = stOf(o), c = s2 && s2.list.filter(function (x) { return x.iso_code === o.getAttribute("data-iso"); })[0];
      if (c) { close(s2, false); choose(s2, c, true); }
