    if (/[^\d\s+()\-.]/.test(e.data) && !/\d/.test(e.data)) e.preventDefault();
  });
  // Escape closes only the list: caught on the window before a drawer or dialog sees it.
  addEventListener("keydown", function (e) {
    if (e.key !== "Escape" || !openSt || !openSt.root.contains(e.target)) return;
    e.preventDefault(); e.stopPropagation(); close(openSt, true);
  }, true);
  document.addEventListener("keydown", function (e) {
    if (!(e.target.matches && e.target.matches("[data-cv-phone-q]"))) return;
    var st = stOf(e.target); if (!st) return;
    var n = st.shown.length;
    if (e.key === "ArrowDown") { e.preventDefault(); if (n) active(st, (st.at + 1) % n); }
    else if (e.key === "ArrowUp") { e.preventDefault(); if (n) active(st, (st.at - 1 + n) % n); }
    else if (e.key === "Home" && n) { e.preventDefault(); active(st, 0); }
    else if (e.key === "End" && n) { e.preventDefault(); active(st, n - 1); }
    else if (e.key === "Enter") { e.preventDefault(); if (st.at >= 0 && st.shown[st.at]) { var c = st.shown[st.at]; close(st, false); choose(st, c, true); } }
    else if (e.key === "Tab") close(st, false);
