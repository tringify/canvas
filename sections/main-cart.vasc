    return st.cur.dial_code + national(st.cur, d);
  }
  function sync(st) { st.out.value = value(st); }
  function load(st, s) {
    var hit = detect(st, s, true);
    if (hit) { st.cur = hit.c; st.num.value = group(hit.c, cap(hit.c, hit.rest)); } else st.num.value = String(s || "").trim();
  }
  function setup(root) {
    if (root.__cvPh !== undefined) return root.__cvPh;
    root.__cvPh = null;
    var list = countries(root);
    if (!list.length) return null;
    var st = {
      root: root, list: list, num: root.querySelector("[data-cv-phone-num]"), out: root.querySelector("[data-cv-phone-out]"),
      btn: root.querySelector("[data-cv-phone-cc]"), pop: root.querySelector("[data-cv-phone-pop]"), q: root.querySelector("[data-cv-phone-q]"),
      ul: root.querySelector("[data-cv-phone-list]"), row: root.querySelector("[data-cv-phone-row]"), cur: null, shown: [], one: list.length === 1
    };
    var want = String(root.getAttribute("data-default") || "").toUpperCase();
    st.def = list.filter(function (c) { return c.iso_code === want; })[0] || list[0];
