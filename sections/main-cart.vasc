    }
  });
  document.addEventListener("focusout", function (e) {
    if (!(e.target.matches && e.target.matches("[data-cv-phone-num]"))) return;
    var st = stOf(e.target), hit = st && !st.one && detect(st, st.num.value, true);
    if (hit) { st.num.value = hit.rest; choose(st, hit.c, false); }
  });
  // Only digits and the usual separators can be typed; a letter never reaches the field.
  document.addEventListener("beforeinput", function (e) {
