{%- comment -%}partial:phone-script{%- endcomment -%}
<script>
(function () {
  // Phone fields ([data-cv-phone]): a country button (country code and dial code) opens a searchable list of the
  // store's phone countries. The visible field then takes the national number, and a hidden field sends
  // one E.164 number (+ and digits) under the original name. A number typed or pasted with + or 00 moves
  // to its country. Without the script, or without country data, the field takes an international number.
  if (window.__cvPhone) return; window.__cvPhone = true;
  // Countries sharing a dial code: a number is shown under the code's main country unless the current or default country shares it.
  var MAIN = { "1": "US", "7": "RU", "39": "IT", "44": "GB", "47": "NO", "61": "AU", "212": "MA", "262": "RE", "290": "SH", "358": "FI", "590": "GP", "599": "CW" };
  // National trunk prefixes that the international number drops: [prefix, national length after it (0: any)].
  // Most countries use a single 0; these keep their leading 0 (it is part of the number) or use another prefix.
  var TRUNK = { IT: null, SM: null, VA: null, CI: null, CG: null, GA: null, HU: ["06", 0], RU: ["8", 10], KZ: ["8", 10], BY: ["80", 9], LT: ["8", 8], TM: ["8", 8], TJ: ["8", 9] };
  var TOP = typeof HTMLElement !== "undefined" && typeof HTMLElement.prototype.showPopover === "function";
  var lists = {};
  function digits(s) { return String(s || "").replace(/\D/g, ""); }
  function fold(s) { return String(s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase(); }
  // The country's ISO code in a small badge: emoji flags render as two letters on Windows anyway.
  function flagOf(c) {
    var iso = String(c.iso_code || "").toUpperCase();
    return /^[A-Z]{2}$/.test(iso) ? iso : "";
  }
  // Fields on one page share the same list; it is parsed and sorted once.
  function countries(root) {
    var raw = root.getAttribute("data-countries") || "[]";
    if (lists[raw]) return lists[raw];
    var list = []; try { list = JSON.parse(raw); } catch (_) {}
    list = (list || []).filter(function (c) { return c && c.iso_code && c.name && /^\+[0-9]+$/.test(c.dial_code || ""); });
    var coll = window.Intl && Intl.Collator ? new Intl.Collator(document.documentElement.lang || undefined, { sensitivity: "base" }) : null;
    list.sort(function (a, b) { return coll ? coll.compare(a.name, b.name) : (a.name < b.name ? -1 : 1); });
    return (lists[raw] = list);
  }
  // "+44 (0)7700 900123" or "0044 7700 900123" -> { c: GB, rest: "7700900123" }. While the code is still being
  // typed (a longer dial code could match, or nothing follows it) it waits unless final.
  function detect(st, s, final) {
    var compact = String(s || "").replace(/\(0\)/g, "").replace(/[^0-9+]/g, "");
    var intl = compact.charAt(0) === "+" ? compact.slice(1) : /^00/.test(compact) ? compact.slice(2) : null;
    if (intl === null) return null;
    var d = digits(intl), best = null, bl = 0;
    if (!final && st.list.some(function (c) { var dc = digits(c.dial_code); return dc.length > d.length && dc.indexOf(d) === 0; })) return null;
    st.list.forEach(function (c) {
      var dc = digits(c.dial_code);
      if (!dc || d.indexOf(dc) !== 0 || dc.length < bl) return;
      if (dc.length > bl) { best = c; bl = dc.length; return; }
      var rank = function (x) { return x === st.cur ? 3 : x === st.def ? 2 : MAIN[dc] === x.iso_code ? 1 : 0; };
      if (rank(c) > rank(best)) best = c;
    });
    if (!best) return null;
    var rest = d.slice(bl);
    if (!final && !rest) return null;
    return { c: best, rest: rest };
  }
  function national(c, d) {
    var t = TRUNK.hasOwnProperty(c.iso_code) ? TRUNK[c.iso_code] : digits(c.dial_code) === "1" ? ["1", 10] : ["0", 0];
    if (t && d.indexOf(t[0]) === 0 && (!t[1] || d.length === t[0].length + t[1])) return d.slice(t[0].length);
    return d;
  }
  // The typed national number, cut to the country's longest number (a leading trunk prefix such as 0 is extra).
  function cap(c, d) {
    var max = +c.max_digits || 0;
    if (!max) return d.slice(0, 15);
    var extra = d.length - national(c, d).length;
    return d.slice(0, extra + max);
  }
  // Groups digits like the country's sample number ("081 234 5678"); the sample's trunk prefix is
  // left out when the shopper did not type one. Digits beyond the sample follow after a space.
  function group(c, d) {
    var ex = String(c.example || ""), exd = digits(ex);
    if (!d || !exd) return d;
    var lead = exd.length - national(c, exd).length;
    if (lead && d.slice(0, lead) !== exd.slice(0, lead)) {
      var seen = 0, i = 0;
      while (i < ex.length && seen < lead) { if (/\d/.test(ex.charAt(i))) seen++; i++; }
      ex = ex.slice(i).replace(/^[^\d(]+/, "");
    }
    var out = "", k = 0;
    for (var j = 0; j < ex.length && k < d.length; j++) out += /\d/.test(ex.charAt(j)) ? d.charAt(k++) : ex.charAt(j);
    return k < d.length ? out + " " + d.slice(k) : out;
  }
  // A national number as typed: digits only, within the country's length, grouped. The caret keeps
  // its place among the digits, so editing in the middle of the number works.
  function shape(st) {
    var el = st.num, v = String(el.value || "");
    if (/^\s*(\+|00)/.test(v)) { if (v.length > 20) el.value = v.slice(0, 20); return; }
    var at = el.selectionStart == null ? v.length : el.selectionStart;
    var before = digits(v.slice(0, at)).length, d = cap(st.cur, digits(v)), next = group(st.cur, d);
    if (next === v) return;
    el.value = next;
    var pos = 0, n = 0;
    while (pos < next.length && n < Math.min(before, d.length)) { if (/\d/.test(next.charAt(pos))) n++; pos++; }
    if (document.activeElement === el) el.setSelectionRange(pos, pos);
  }
  function value(st) {
    var s = String(st.num.value || "").trim(), compact = s.replace(/\(0\)/g, "").replace(/[^0-9+]/g, ""), d = digits(compact);
    if (!d) return "";
    if (compact.charAt(0) === "+") return "+" + d;
    if (/^00/.test(compact)) return "+" + d.slice(2);
    return st.cur.dial_code + national(st.cur, d);
  }
  function sync(st) { st.out.value = value(st); }
  function load(st, s) {
    var hit = detect(st, s, true);
    if (hit) { st.cur = hit.c; st.num.value = group(hit.c, cap(hit.c, hit.rest)); } else st.num.value = String(s || "").trim();
  }
  function setup(root) {
    if (root.__cvPh !== undefined) return root.__cvPh;
    root.__cvPh = null;
    var list = countries(root);
    if (!list.length) return null;
    var st = {
      root: root, list: list, num: root.querySelector("[data-cv-phone-num]"), out: root.querySelector("[data-cv-phone-out]"),
      btn: root.querySelector("[data-cv-phone-cc]"), pop: root.querySelector("[data-cv-phone-pop]"), q: root.querySelector("[data-cv-phone-q]"),
      ul: root.querySelector("[data-cv-phone-list]"), row: root.querySelector("[data-cv-phone-row]"), cur: null, shown: [], one: list.length === 1
    };
    var want = String(root.getAttribute("data-default") || "").toUpperCase();
    st.def = list.filter(function (c) { return c.iso_code === want; })[0] || list[0];
    // Setting a hidden input's value rewrites its default, so the saved number is kept for a form reset.
    st.cur = st.def; st.saved = st.out.getAttribute("value") || st.num.getAttribute("value") || "";
    load(st, st.saved);
    // From here the visible field holds the national number and the hidden one is sent.
    st.out.name = st.out.getAttribute("data-name"); st.num.removeAttribute("name");
    st.num.removeAttribute("pattern"); st.num.removeAttribute("title");
    if (st.num.getAttribute("autocomplete") === "tel") st.num.setAttribute("autocomplete", "tel-national");
    if (st.one) {
      // A single country is a fixed prefix, read with the number.
