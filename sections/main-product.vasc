  }
  function choose(st, c, focus) {
    st.cur = c;
    var root = st.root, label = (root.getAttribute("data-label-selected") || "").replace("__C__", c.name + " (" + c.dial_code + ")");
    root.querySelectorAll("[data-cv-phone-flag]").forEach(function (el) { el.textContent = flagOf(c); });
    root.querySelectorAll("[data-cv-phone-dial]").forEach(function (el) { el.textContent = c.dial_code; });
    root.querySelectorAll("[data-cv-phone-cc-label]").forEach(function (el) { el.textContent = label; });
    var hint = root.querySelector("[data-cv-phone-hint]");
    if (hint) { hint.textContent = c.example ? (root.getAttribute("data-label-example") || "").replace("__EX__", c.example) : ""; hint.hidden = !c.example; }
    if (c.example) st.num.setAttribute("placeholder", c.example); else st.num.removeAttribute("placeholder");
    shape(st);
    sync(st);
    if (focus) st.num.focus();
  }
  function render(st) {
    var raw = st.q.value.trim(), q = fold(raw), qd = digits(raw);
    // Names that start with the search come first, then names with a word starting with it, then the rest.
    function rank(c) {
      var n = fold(c.name);
      if (c.iso_code.toLowerCase() === q || n.indexOf(q) === 0) return 0;
      if (new RegExp("[\\s(\\-]" + q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).test(n)) return 1;
      return 2;
    }
    st.shown = st.list.filter(function (c) {
      return !raw || fold(c.name).indexOf(q) !== -1 || c.iso_code.toLowerCase() === q || (qd && digits(c.dial_code).indexOf(qd) === 0);
    });
    if (q && !qd) st.shown = st.shown.map(function (c, i) { return [rank(c), i, c]; }).sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; }).map(function (x) { return x[2]; });
    var frag = document.createDocumentFragment();
    st.shown.forEach(function (c) {
      var li = document.createElement("li");
      li.id = st.ul.id + "-" + c.iso_code; li.className = "cv-phone__opt" + (c === st.cur ? " is-current" : "");
      li.setAttribute("role", "option"); li.setAttribute("aria-selected", "false"); li.setAttribute("data-iso", c.iso_code);
      var f = document.createElement("span"); f.className = "cv-phone__oflag"; f.setAttribute("aria-hidden", "true"); f.textContent = flagOf(c);
      var n = document.createElement("span"); n.className = "cv-phone__oname"; n.textContent = c.name;
      var dl = document.createElement("bdi"); dl.className = "cv-phone__odial"; dl.setAttribute("dir", "ltr"); dl.textContent = c.dial_code;
      li.appendChild(f); li.appendChild(n); li.appendChild(dl); frag.appendChild(li);
    });
    st.ul.replaceChildren(frag);
    st.root.querySelector("[data-cv-phone-none]").textContent = st.shown.length ? "" : st.root.querySelector("[data-cv-phone-none-text]").textContent;
    var at = raw ? 0 : st.shown.indexOf(st.cur);
    active(st, st.shown.length ? Math.max(0, at) : -1);
  }
  function active(st, i) {
    var opts = st.ul.children;
    st.at = i;
    for (var k = 0; k < opts.length; k++) { opts[k].setAttribute("aria-selected", k === i ? "true" : "false"); opts[k].classList.toggle("is-active", k === i); }
    if (i >= 0 && opts[i]) { st.q.setAttribute("aria-activedescendant", opts[i].id); opts[i].scrollIntoView({ block: "nearest" }); }
    else st.q.removeAttribute("aria-activedescendant");
  }
  // In the top layer the list is never clipped by a drawer or panel; it sits under the field, or above it when there is more room there.
  function place(st) {
    if (!TOP) return;
    var r = st.row.getBoundingClientRect(), vh = window.innerHeight, below = vh - r.bottom - 12, above = r.top - 12, up = below < 240 && above > below;
    // At least 300px wide in a narrow row (a cart line), kept inside the window and aligned to the field's start edge.
    var vw = document.documentElement.clientWidth, w = Math.min(Math.max(r.width, 300), vw - 16);
    var x = getComputedStyle(st.root).direction === "rtl" ? r.right - w : r.left, s = st.pop.style;
    s.left = Math.min(Math.max(8, x), vw - 8 - w) + "px"; s.width = w + "px";
    if (up) { s.top = "auto"; s.bottom = (vh - r.top + 6) + "px"; } else { s.bottom = "auto"; s.top = (r.bottom + 6) + "px"; }
    s.setProperty("--cv-phone-room", Math.max(140, (up ? above : below) - 80) + "px");
  }
  function isOpen(st) { return !!st && (TOP ? st.pop.matches(":popover-open") : !st.pop.hidden); }
  var openSt = null;
  function open(st) {
    if (openSt && openSt !== st) close(openSt, false);
    openSt = st; st.btn.setAttribute("aria-expanded", "true");
    if (TOP) { st.pop.showPopover(); place(st); } else st.pop.hidden = false;
    st.q.value = ""; render(st); st.q.focus();
  }
  function close(st, back) {
    if (!isOpen(st)) return;
    if (TOP) st.pop.hidePopover(); else st.pop.hidden = true;
    st.btn.setAttribute("aria-expanded", "false");
    if (openSt === st) openSt = null;
    if (back) st.btn.focus();
  }
  function stOf(el) { var root = el && el.closest && el.closest("[data-cv-phone]"); return root ? setup(root) : null; }
  document.addEventListener("click", function (e) {
    var b = e.target.closest && e.target.closest("[data-cv-phone-cc]");
    if (b) { var st = stOf(b); if (st) { if (isOpen(st)) close(st, true); else open(st); } return; }
    var o = e.target.closest && e.target.closest(".cv-phone__opt");
    if (o) {
      var s2 = stOf(o), c = s2 && s2.list.filter(function (x) { return x.iso_code === o.getAttribute("data-iso"); })[0];
      if (c) { close(s2, false); choose(s2, c, true); }
      return;
    }
    if (openSt && !openSt.root.contains(e.target)) close(openSt, false);
  });
  document.addEventListener("input", function (e) {
    if (e.target.matches && e.target.matches("[data-cv-phone-q]")) { var st = stOf(e.target); if (st) render(st); return; }
    if (e.target.matches && e.target.matches("[data-cv-phone-num]")) {
      var s2 = stOf(e.target); if (!s2) return;
      var hit = detect(s2, s2.num.value, false);
      if (hit && !s2.one) { s2.num.value = hit.rest; choose(s2, hit.c, false); } else { shape(s2); sync(s2); }
    }
  });
  document.addEventListener("focusout", function (e) {
    if (!(e.target.matches && e.target.matches("[data-cv-phone-num]"))) return;
    var st = stOf(e.target), hit = st && !st.one && detect(st, st.num.value, true);
    if (hit) { st.num.value = hit.rest; choose(st, hit.c, false); }
  });
  // Only digits and the usual separators can be typed; a letter never reaches the field.
  document.addEventListener("beforeinput", function (e) {
    if (!(e.target.matches && e.target.matches("[data-cv-phone-num]")) || !e.data || !/^insert/.test(e.inputType)) return;
    if (/[^\d\s+()\-.]/.test(e.data) && !/\d/.test(e.data)) e.preventDefault();
  });
  // Escape closes only the list: caught on the window before a drawer or dialog sees it.
  addEventListener("keydown", function (e) {
    if (e.key !== "Escape" || !openSt || !openSt.root.contains(e.target)) return;
    e.preventDefault(); e.stopPropagation(); close(openSt, true);
  }, true);
  document.addEventListener("keydown", function (e) {
    if (!(e.target.matches && e.target.matches("[data-cv-phone-q]"))) return;
    var st = stOf(e.target); if (!st) return;
    var n = st.shown.length;
    if (e.key === "ArrowDown") { e.preventDefault(); if (n) active(st, (st.at + 1) % n); }
    else if (e.key === "ArrowUp") { e.preventDefault(); if (n) active(st, (st.at - 1 + n) % n); }
    else if (e.key === "Home" && n) { e.preventDefault(); active(st, 0); }
    else if (e.key === "End" && n) { e.preventDefault(); active(st, n - 1); }
    else if (e.key === "Enter") { e.preventDefault(); if (st.at >= 0 && st.shown[st.at]) { var c = st.shown[st.at]; close(st, false); choose(st, c, true); } }
    else if (e.key === "Tab") close(st, false);
