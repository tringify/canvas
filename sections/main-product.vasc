  }
  document.addEventListener("pointerup", release);
  document.addEventListener("pointercancel", release);
  // An add from the page's form (the bar's or the sheet's Add to cart) closes the sheet before the cart drawer, notice or cart page follows.
  document.addEventListener("tf:action-success", function (e) {
    var d = e.detail || {}, sec = d.action === "cart_add" && d.form && d.form.closest && d.form.closest(".cv-pdp");
    if (sec) close(sec.querySelector("[data-cv-satc-sheet]"), false);
  });
  // Coming back to the page (the back button) never shows a sheet left open.
  addEventListener("pageshow", function (e) { if (e.persisted) close(openSheet(), false); });
  // The bar's, the sheet's and the form's quantity are one value: a change in any (− / +, typed, arrow keys) sets the others.
  document.addEventListener("change", function (e) {
    var i = e.target;
    if (!(i.matches && i.matches("input[data-cv-qty]")) || i.hasAttribute("data-cv-qty-line")) return;
    var sec = i.closest(".cv-pdp");
    if (!sec || !sec.querySelector("[data-cv-satc]")) return;
    var list = [].slice.call(sec.querySelectorAll(".cv-pdp__info .cv-pdp__form input[data-cv-qty], input[data-cv-satc-qty]"));
    if (list.indexOf(i) < 0) return;
    list.forEach(function (o) { if (o !== i && o.value !== i.value) o.value = o.defaultValue = i.value; });
  });
})();
</script>
<script>
(function () {
  // 3D models: a gallery model slide shows its poster and a link to the model file. When the slide comes
  // near the screen, or the shopper presses View in 3D, the pinned <model-viewer> loads (once per page)
  // and takes over the slide; if it cannot load, the poster and link stay. Touch screens rotate the model
  // only after Rotate is pressed, so a swipe still moves the gallery.
  if (window.__cvModels) return; window.__cvModels = true;
  var LIB = "https://cdn.jsdelivr.net/npm/@google/model-viewer@4.3.1/dist/model-viewer.min.js";
  var SRI = "sha384-cprcVQt7wbUl0xngF3PGP6yBB7n4/t+4AoAMG9biiMCGFiWOdzUH10Ie2COTqFNW";
  var lib = null, failed = false;
  var still = matchMedia("(prefers-reduced-motion: reduce)"), coarse = matchMedia("(pointer: coarse)");
  function load() {
    if (window.customElements && customElements.get("model-viewer")) return Promise.resolve();
    if (lib) return lib;
    lib = new Promise(function (ok, fail) {
      var s = document.createElement("script");
      s.type = "module"; s.src = LIB; s.integrity = SRI; s.crossOrigin = "anonymous";
      s.onload = function () { customElements.whenDefined("model-viewer").then(ok, fail); };
      s.onerror = fail;
      document.head.appendChild(s);
    });
    lib.catch(function () { failed = true; });
    return lib;
  }
  function into(mv) { var k = mv.shadowRoot && mv.shadowRoot.querySelector(".userInput"); if (k) k.focus(); }
  function giveUp(box) {
    box.classList.remove("is-loading", "is-live"); box.removeAttribute("aria-busy"); box.__cvFailed = true;
    var mv = box.querySelector("model-viewer"); if (mv) mv.remove();
    var r = box.querySelector("[data-cv-model-rotate]"); if (r) r.remove();
    var link = box.querySelector("[data-cv-model-open]"); if (link) link.hidden = false;
  }
  function mount(box, focus) {
    if (box.__cvMounted || box.__cvFailed || failed) return;
    box.__cvMounted = true; box.classList.add("is-loading"); box.setAttribute("aria-busy", "true");
    load().then(function () {
      var mv = document.createElement("model-viewer");
      mv.setAttribute("src", box.getAttribute("data-src"));
      if (box.getAttribute("data-poster")) mv.setAttribute("poster", box.getAttribute("data-poster"));
      mv.setAttribute("alt", box.getAttribute("data-alt") || "");
      mv.setAttribute("ar", ""); mv.setAttribute("ar-modes", "webxr scene-viewer quick-look");
      mv.setAttribute("touch-action", "pan-y"); mv.setAttribute("shadow-intensity", "0.7");
      mv.setAttribute("interaction-prompt", still.matches ? "none" : "auto");
      if (!coarse.matches) mv.setAttribute("camera-controls", "");
      var ar = document.createElement("button");
      ar.type = "button"; ar.slot = "ar-button"; ar.className = "cv-btn cv-btn--sm cv-pdp__model-ar"; ar.textContent = box.getAttribute("data-ar-label");
      mv.appendChild(ar);
      mv.addEventListener("progress", function (e) { box.style.setProperty("--cv-model-progress", String(e.detail && e.detail.totalProgress || 0)); });
      mv.addEventListener("load", function () {
        box.classList.remove("is-loading"); box.classList.add("is-live"); box.removeAttribute("aria-busy");
        var link = box.querySelector("[data-cv-model-open]"), had = link && link.contains(document.activeElement);
        if (link) link.hidden = true;
        if (focus || had || box.__cvWantFocus) { box.__cvWantFocus = true; into(mv); }
        variants(box, mv);
      });
      // The viewer's keyboard target (arrow keys orbit, +/- zoom) is in its shadow root, focusable once the poster is gone.
      mv.addEventListener("poster-dismissed", function () { if (box.__cvWantFocus) into(mv); });
      mv.addEventListener("error", function () { giveUp(box); });
      box.appendChild(mv);
      if (coarse.matches) {
        var rot = document.createElement("button");
        rot.type = "button"; rot.className = "cv-btn cv-btn--sm cv-pdp__model-rotate"; rot.setAttribute("data-cv-model-rotate", "");
        rot.setAttribute("aria-pressed", "false"); rot.textContent = box.getAttribute("data-rotate-label");
        box.appendChild(rot);
      }
    }, function () { giveUp(box); });
  }
  // A model with built-in variants (glTF KHR_materials_variants, such as colourways) gets one button per
  // variant, named as the file names it; the first is shown until the shopper picks another.
  function variants(box, mv) {
    var names = mv.availableVariants || [];
    if (names.length < 2 || box.querySelector("[data-cv-model-variants]")) return;
    var group = document.createElement("div");
    group.className = "cv-pdp__model-variants"; group.setAttribute("role", "group");
    group.setAttribute("aria-label", box.getAttribute("data-variants-label")); group.setAttribute("data-cv-model-variants", "");
    var current = mv.variantName || names[0];
    names.forEach(function (name) {
      var b = document.createElement("button");
      b.type = "button"; b.className = "cv-pdp__model-variant"; b.textContent = name.replace(/[-_]+/g, " ");
      b.setAttribute("aria-pressed", name === current ? "true" : "false");
      b.addEventListener("click", function () {
        mv.variantName = name;
        group.querySelectorAll("button").forEach(function (o) { o.setAttribute("aria-pressed", o === b ? "true" : "false"); });
      });
      group.appendChild(b);
    });
    box.appendChild(group);
  }
  document.addEventListener("click", function (e) {
    var open = e.target.closest && e.target.closest("[data-cv-model-open]"), box = open && open.closest("[data-cv-model]");
    if (box && !box.__cvFailed && !failed) { e.preventDefault(); box.__cvWantFocus = true; mount(box, true); return; }
    var rot = e.target.closest && e.target.closest("[data-cv-model-rotate]");
    if (!rot) return;
    var mv = rot.closest("[data-cv-model]").querySelector("model-viewer"), on = rot.getAttribute("aria-pressed") !== "true";
    rot.setAttribute("aria-pressed", on ? "true" : "false");
    if (!mv) return;
    if (on) { mv.setAttribute("camera-controls", ""); mv.setAttribute("touch-action", "none"); } else { mv.removeAttribute("camera-controls"); mv.setAttribute("touch-action", "pan-y"); }
  });
  function watch() {
    var boxes = document.querySelectorAll("[data-cv-model]:not([data-cv-model-watched])");
    if (!boxes.length) return;
    var io = "IntersectionObserver" in window ? new IntersectionObserver(function (es) {
      es.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); mount(en.target, false); } });
    }, { rootMargin: "200px" }) : null;
    boxes.forEach(function (b) { b.setAttribute("data-cv-model-watched", ""); if (io) io.observe(b); });
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", watch); else watch();
  // A refreshed product section (another variant chosen) brings new slides.
  document.addEventListener("tf:action-done", watch);
  var watchT = 0;
  new MutationObserver(function () { cancelAnimationFrame(watchT); watchT = requestAnimationFrame(watch); }).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
{%- comment -%}partial:qty{%- endcomment -%}
<script>
// Typed quantities ([data-cv-qty]): cart lines and the product page. A value is committed on
// Enter, on blur, or after a pause in typing, never per keystroke. It is clamped to data-min…data-max
// (the platform's limits); empty or invalid input goes back to the last good value. A cart line
// commits through its own form, the same cart_update the − / + buttons use, and 0 submits the
// line's remove form. The product page only keeps the value in range for Add to cart.
(function () {
  if (window.__cvQty) return; window.__cvQty = true;
  var PAUSE = 600;
  function field(t) { return t && t.matches && t.matches("input[data-cv-qty]") ? t : null; }
  function isLine(i) { return i.hasAttribute("data-cv-qty-line"); }
  function last(i) { return parseInt(i.defaultValue, 10) || 0; }
  function max(i) { return i.hasAttribute("data-max") ? parseInt(i.getAttribute("data-max"), 10) : Infinity; }
  function say(msg) { if (msg && window.tringify && tringify.ui && tringify.ui.toast) tringify.ui.toast(msg); }
  function lineForms(i) {
    var line = i.closest(".cv-line");
    return { qty: i.form, rm: line && line.querySelector("form.cv-line__remove") };
  }
  function submit(form, button) {
    if (!form || !button) return;
    if (form.requestSubmit) form.requestSubmit(button); else button.click();
  }
  // why: "enter", "blur" or "pause". A pause leaves an unfinished entry alone and never removes a line.
  function commit(i, why) {
    clearTimeout(i.__cvQtyT); i.__cvQtyT = null;
    var was = i.__cvQtyFor; i.__cvQtyFor = null;
    if (i.readOnly) return true;
    // A refresh can redraw this field as another line while the shopper is typing in it.
    if (was && was !== i.getAttribute("data-cv-qty-line")) { i.value = last(i); return false; }
    var raw = i.value.trim();
    if (!/^[0-9]+$/.test(raw)) { if (why !== "pause") i.value = last(i); return false; }
    var v = parseInt(raw, 10), min = parseInt(i.getAttribute("data-min"), 10) || 0;
    if (v === 0 && isLine(i) && why === "pause") return true;
    if (v > max(i)) { v = max(i); say(i.getAttribute("data-max-msg")); }
    if (v < min) v = min;
    i.value = v;
    if (v === last(i)) return true;
    if (!isLine(i)) { i.defaultValue = v; i.dispatchEvent(new Event("change", { bubbles: true })); return true; }
    var f = lineForms(i);
    if (v === 0) submit(f.rm, f.rm && f.rm.querySelector("[type=submit]"));
    else { var set = f.qty.querySelector("[data-cv-qty-set]"); set.value = v; submit(f.qty, set); }
    return true;
  }
  document.addEventListener("input", function (e) {
    var i = field(e.target); if (!i) return;
    clearTimeout(i.__cvQtyT);
    if (isLine(i) && !i.__cvQtyFor) i.__cvQtyFor = i.getAttribute("data-cv-qty-line");
    i.__cvQtyT = setTimeout(function () { if (i.isConnected) commit(i, "pause"); }, PAUSE);
  });
  document.addEventListener("focusout", function (e) { var i = field(e.target); if (i) commit(i, "blur"); });
  document.addEventListener("keydown", function (e) {
    var i = field(e.target); if (!i || e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key === "Enter") {
      // On a cart line Enter only updates the line; on the product page it adds to cart once the value is good.
      if (!commit(i, "enter") || isLine(i)) e.preventDefault();
      return;
    }
    if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
    e.preventDefault();
    if (i.readOnly) return;
    var cur = /^[0-9]+$/.test(i.value.trim()) ? parseInt(i.value, 10) : last(i);
    var v = Math.max(1, Math.min(max(i), cur + (e.key === "ArrowUp" ? 1 : -1)));
    if (String(v) === i.value) return;
    i.value = v;
    i.dispatchEvent(new Event("input", { bubbles: true }));
  });
  // Busy state: while a line's update or removal is in flight its field is read-only and its
  // − / + are disabled. A refresh redraws the line from the cart, so typed values are reset to it.
  function lineOf(form) {
    var acts = form && form.closest && form.closest(".cv-line__actions");
    return acts && acts.querySelector("input[data-cv-qty-line]");
  }
  function busy(form, on) {
    var i = lineOf(form); if (!i) return;
    i.readOnly = on;
    if (on) i.form.setAttribute("aria-busy", "true"); else i.form.removeAttribute("aria-busy");
    i.form.querySelectorAll(".cv-qty__btn").forEach(function (b) {
      if (on && !b.disabled) { b.disabled = true; b.setAttribute("data-cv-qty-busy", ""); }
      else if (!on && b.hasAttribute("data-cv-qty-busy")) { b.disabled = false; b.removeAttribute("data-cv-qty-busy"); }
    });
  }
  function sync() {
    document.querySelectorAll("input[data-cv-qty-line]").forEach(function (i) {
      if (i.__cvQtyFor && i.__cvQtyFor !== i.getAttribute("data-cv-qty-line")) { clearTimeout(i.__cvQtyT); i.__cvQtyT = null; i.__cvQtyFor = null; }
      if (!i.__cvQtyT && i.value !== i.defaultValue) i.value = i.defaultValue;
    });
  }
  function isCart(d) { return d && (d.action === "cart_update" || d.action === "cart_remove"); }
  document.addEventListener("tf:action-start", function (e) { if (isCart(e.detail)) busy(e.detail.form, true); });
  document.addEventListener("tf:action-done", function (e) { if (isCart(e.detail)) busy(e.detail.form, false); sync(); });
  // A refused update leaves the cart as it was: the platform's message shows as for − / +, and the field goes back.
  document.addEventListener("tf:action-error", function (e) { if (isCart(e.detail)) { busy(e.detail.form, false); var i = lineOf(e.detail.form); if (i) i.value = i.defaultValue; } });
})();
</script>
{%- comment -%}/partial:qty{%- endcomment -%}
