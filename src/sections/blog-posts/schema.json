{
  "name": "blog-posts",
  "icon": "newspaper",
  "ctx_needs": [
    "routes",
    "blog_recent",
    "design_mode"
  ],
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "default": "@t:sections.blog_posts.heading",
      "editor": {
        "label": "heading",
        "group": "content"
      }
    },
    {
      "id": "limit",
      "type": "range",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "editor": {
        "label": "posts_to_show",
        "group": "content"
      }
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "show_excerpt",
        "group": "content"
      }
    },
    {
      "id": "show_author",
      "type": "checkbox",
      "default": false,
      "editor": {
        "label": "show_author",
        "group": "content"
      }
    },
    {
      "id": "fallback_photo",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "opt_photo_auto"
        },
        {
          "value": "room",
          "label": "opt_photo_room"
        },
        {
          "value": "table",
          "label": "opt_photo_table"
        },
        {
          "value": "shelf",
          "label": "opt_photo_shelf"
        },
        {
          "value": "corner",
          "label": "opt_photo_corner"
        },
        {
          "value": "parcel",
          "label": "opt_photo_parcel"
        },
        {
          "value": "linen",
          "label": "opt_photo_linen"
        },
        {
          "value": "bedroom",
          "label": "opt_photo_bedroom"
        },
        {
          "value": "bench",
          "label": "opt_photo_bench"
        },
        {
          "value": "evening",
          "label": "opt_photo_evening"
        },
        {
          "value": "off",
          "label": "opt_photo_none"
        }
      ],
      "editor": {
        "label": "fallback_photo_posts",
        "group": "content"
      }
    },
    {
      "id": "columns",
      "type": "range",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "editor": {
        "label": "columns_desktop",
        "group": "layout"
      }
    },
    {
      "id": "padding",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "opt_spacing_theme"
        },
        {
          "value": "compact",
          "label": "opt_compact"
        },
        {
          "value": "relaxed",
          "label": "opt_relaxed"
        },
        {
          "value": "none",
          "label": "opt_spacing_none"
        }
      ],
      "editor": {
        "label": "section_padding",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "presets": [
    {
      "name": "blog-posts",
      "category": "blog"
    }
  ]
}
