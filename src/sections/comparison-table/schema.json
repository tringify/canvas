{
  "name": "comparison-table",
  "icon": "table",
  "ctx_needs": [
    "routes",
    "design_mode"
  ],
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "editor": {
        "label": "heading",
        "group": "content"
      },
      "default": "@t:sections.comparison_table.heading"
    },
    {
      "id": "text",
      "type": "textarea",
      "editor": {
        "label": "text",
        "group": "content"
      },
      "default": ""
    },
    {
      "id": "highlight",
      "type": "select",
      "editor": {
        "label": "highlight_column",
        "group": "design"
      },
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "opt_none"
        },
        {
          "value": "1",
          "label": "opt_column_1"
        },
        {
          "value": "2",
          "label": "opt_column_2"
        },
        {
          "value": "3",
          "label": "opt_column_3"
        },
        {
          "value": "4",
          "label": "opt_column_4"
        }
      ]
    },
    {
      "id": "padding",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "opt_spacing_theme"
        },
        {
          "value": "compact",
          "label": "opt_compact"
        },
        {
          "value": "relaxed",
          "label": "opt_relaxed"
        },
        {
          "value": "none",
          "label": "opt_spacing_none"
        }
      ],
      "editor": {
        "label": "section_padding",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
