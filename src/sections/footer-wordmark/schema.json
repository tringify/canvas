{
  "name": "footer-wordmark",
  "kind": "layout",
  "target": "global_body_end",
  "icon": "panel-bottom",
  "preview_image": "assets/canvas-layout-footer-wordmark.png",
  "ctx_needs": [
    "shop",
    "customer_settings.privacy_request_url",
    "localization",
    "policies",
    "form_notice",
    "csrf_token",
    "consent",
    "design_mode"
  ],
  "settings": [
    {
      "id": "wordmark_text",
      "type": "text",
      "default": "",
      "editor": {
        "label": "wordmark_text",
        "group": "wordmark"
      }
    },
    {
      "id": "wordmark_image",
      "type": "image",
      "editor": {
        "label": "wordmark_image",
        "group": "wordmark"
      }
    },
    {
      "id": "wordmark_position",
      "type": "select",
      "default": "bottom",
      "options": [
        {
          "value": "top",
          "label": "opt_top"
        },
        {
          "value": "bottom",
          "label": "opt_bottom"
        }
      ],
      "editor": {
        "label": "wordmark_position",
        "group": "wordmark"
      }
    },
    {
      "id": "wordmark_style",
      "type": "select",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "opt_solid"
        },
        {
          "value": "outline",
          "label": "opt_outline"
        },
        {
          "value": "tint",
          "label": "opt_tint"
        }
      ],
      "editor": {
        "label": "wordmark_style",
        "group": "wordmark"
      }
    },
    {
      "id": "wordmark_crop",
      "type": "checkbox",
      "default": false,
      "editor": {
        "label": "wordmark_crop",
        "group": "wordmark"
      }
    },
    {
      "id": "columns_desktop",
      "type": "range",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "editor": {
        "label": "columns_desktop",
        "group": "layout"
      }
    },
    {
      "id": "columns_tablet",
      "type": "range",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "editor": {
        "label": "columns_tablet",
        "group": "layout"
      }
    },
    {
      "id": "columns_mobile",
      "type": "range",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "editor": {
        "label": "columns_mobile",
        "group": "layout"
      }
    },
    {
      "id": "align",
      "type": "select",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "opt_start"
        },
        {
          "value": "center",
          "label": "opt_center"
        }
      ],
      "editor": {
        "label": "alignment",
        "group": "layout"
      }
    },
    {
      "id": "fold_mobile",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "fold_mobile",
        "group": "layout"
      }
    },
    {
      "id": "spacing",
      "type": "select",
      "default": "normal",
      "options": [
        {
          "value": "compact",
          "label": "opt_compact"
        },
        {
          "value": "normal",
          "label": "opt_normal"
        },
        {
          "value": "relaxed",
          "label": "opt_relaxed"
        }
      ],
      "editor": {
        "label": "section_padding",
        "group": "layout"
      }
    },
    {
      "id": "bar_align",
      "type": "select",
      "default": "spread",
      "options": [
        {
          "value": "spread",
          "label": "opt_spread"
        },
        {
          "value": "start",
          "label": "opt_start"
        },
        {
          "value": "center",
          "label": "opt_center"
        }
      ],
      "editor": {
        "label": "bar_align",
        "group": "layout"
      }
    },
    {
      "id": "divider",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "bar_divider",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "inverse",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "blocks": {
    "accept_theme_blocks": true,
    "theme_blocks": [
      "footer-column",
      "newsletter-form",
      "custom-vascula"
    ],
    "max": 16,
    "default": [
      "copyright",
      "policies",
      "localization",
      "social",
      "payment",
      "powered_by"
    ],
    "types": [
      {
        "type": "copyright",
        "editor": {
          "label": "ft_copyright"
        },
        "settings": [
          {
            "id": "copyright",
            "type": "text",
            "default": "",
            "editor": {
              "label": "copyright",
              "group": "content"
            }
          }
        ]
      },
      {
        "type": "policies",
        "editor": {
          "label": "ft_policies"
        },
        "settings": [
          {
            "id": "show_policies",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_policies",
              "group": "content"
            }
          },
          {
            "id": "show_consent",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_consent",
              "group": "content"
            }
          },
          {
            "id": "show_privacy_request",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_privacy_request",
              "group": "content"
            }
          }
        ]
      },
      {
        "type": "localization",
        "editor": {
          "label": "ft_localization"
        },
        "settings": [
          {
            "id": "show_localization",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_localization",
              "group": "content"
            }
          },
          {
            "id": "picker_style",
            "type": "select",
            "default": "theme",
            "options": [
              {
                "value": "theme",
                "label": "opt_loc_theme"
              },
              {
                "value": "dropdown",
                "label": "opt_loc_dropdown"
              },
              {
                "value": "pill",
                "label": "opt_loc_pill"
              },
              {
                "value": "modal",
                "label": "opt_loc_modal"
              },
              {
                "value": "sheet",
                "label": "opt_loc_sheet"
              },
              {
                "value": "links",
                "label": "opt_loc_links"
              }
            ],
            "editor": {
              "label": "picker_style",
              "group": "design"
            }
          }
        ]
      },
      {
        "type": "social",
        "editor": {
          "label": "ft_social"
        },
        "settings": [
          {
            "id": "show_social",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_social",
              "group": "content"
            }
          },
          {
            "id": "style",
            "type": "select",
            "default": "icons",
            "options": [
              {
                "value": "icons",
                "label": "opt_icons"
              },
              {
                "value": "names",
                "label": "opt_icons_names"
              }
            ],
            "editor": {
              "label": "style",
              "group": "design"
            }
          }
        ]
      },
      {
        "type": "payment",
        "editor": {
          "label": "ft_payment"
        },
        "settings": [
          {
            "id": "payment_methods",
            "type": "text",
            "default": "",
            "editor": {
              "label": "payment_methods",
              "group": "content"
            }
          }
        ]
      },
      {
        "type": "note",
        "editor": {
          "label": "ft_note"
        },
        "settings": [
          {
            "id": "text",
            "type": "richtext",
            "default": "",
            "editor": {
              "label": "text",
              "group": "content"
            }
          }
        ]
      },
      {
        "type": "powered_by",
        "editor": {
          "label": "ft_powered"
        },
        "settings": [
          {
            "id": "show_powered_by",
            "type": "checkbox",
            "default": true,
            "editor": {
              "label": "show_powered_by",
              "group": "content"
            }
          }
        ]
      }
    ]
  },
  "migrations": [
    {
      "id": "text-to-footer-column",
      "op": "rename_block",
      "from_type": "text",
      "to_type": "theme:footer-column",
      "source_defaults": {
        "heading": "@t:sections.footer.text.heading"
      }
    },
    {
      "id": "menu-to-footer-column",
      "op": "rename_block",
      "from_type": "menu",
      "to_type": "theme:footer-column",
      "source_defaults": {
        "heading": "@t:sections.footer.menu.heading",
        "menu": "main-menu"
      }
    },
    {
      "id": "newsletter-to-theme-block",
      "op": "rename_block",
      "from_type": "newsletter",
      "to_type": "theme:newsletter-form"
    }
  ]
}
