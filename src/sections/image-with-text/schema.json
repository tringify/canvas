        "group": "image"
      }
    },
    {
      "id": "fallback_photo",
      "type": "select",
      "default": "table",
      "options": [
        {
          "value": "table",
          "label": "opt_photo_table"
        },
        {
          "value": "room",
          "label": "opt_photo_room"
        },
        {
          "value": "shelf",
          "label": "opt_photo_shelf"
        },
        {
          "value": "corner",
          "label": "opt_photo_corner"
        },
        {
          "value": "parcel",
          "label": "opt_photo_parcel"
        },
        {
          "value": "linen",
          "label": "opt_photo_linen"
        },
        {
          "value": "bedroom",
          "label": "opt_photo_bedroom"
        },
        {
          "value": "bench",
          "label": "opt_photo_bench"
        },
        {
          "value": "evening",
          "label": "opt_photo_evening"
        },
        {
          "value": "none",
          "label": "opt_photo_none"
        }
      ],
      "editor": {
        "label": "fallback_photo",
        "group": "image"
      }
    },
    {
      "id": "layout",
      "type": "select",
      "default": "side",
      "options": [
        {
          "value": "side",
          "label": "opt_side_by_side"
        },
        {
          "value": "overlap",
          "label": "opt_overlap"
