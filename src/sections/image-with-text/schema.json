    {
      "id": "image_width",
      "type": "select",
      "default": "half",
      "options": [
        {
          "value": "small",
          "label": "opt_small"
        },
        {
          "value": "half",
          "label": "opt_medium"
        },
        {
          "value": "large",
          "label": "opt_large"
        }
      ],
      "editor": {
        "label": "image_width",
        "group": "layout"
      }
    },
    {
      "id": "image_ratio",
      "type": "select",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "opt_landscape"
        },
        {
          "value": "square",
          "label": "opt_square"
        },
        {
          "value": "portrait",
          "label": "opt_portrait"
        }
      ],
      "editor": {
        "label": "image_ratio",
        "group": "layout"
      }
    },
    {
      "id": "padding",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "opt_spacing_theme"
        },
        {
          "value": "compact",
          "label": "opt_compact"
        },
        {
          "value": "relaxed",
          "label": "opt_relaxed"
        },
        {
          "value": "none",
          "label": "opt_spacing_none"
        }
      ],
      "editor": {
        "label": "section_padding",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "presets": [
    {
      "name": "image-with-text",
      "category": "image",
      "blocks": [
        {
          "type": "theme:heading",
          "settings": {
            "heading": "@t:sections.image_with_text.heading"
          }
        },
        {
          "type": "theme:text"
        }
      ]
    }
  ],
  "blocks": {
    "accept_theme_blocks": true,
    "theme_blocks": [
      "eyebrow",
      "heading",
      "text",
      "buttons",
      "image",
      "spacer",
      "custom-vascula"
    ],
    "max": 12
  },
  "migrations": [
    {
      "id": "image-with-text-copy-to-blocks",
      "op": "settings_to_blocks",
      "blocks": [
        {
          "type": "theme:eyebrow",
          "settings": {
            "text": "eyebrow"
          }
        },
        {
          "type": "theme:heading",
          "settings": {
            "heading": "heading"
          }
        },
        {
          "type": "theme:text",
          "settings": {
            "text": "text"
          }
        },
        {
          "type": "theme:buttons",
          "settings": {
            "button_label": "button_label",
            "button_link": "button_link",
            "button_style": "button_style",
            "button_scheme": "button_scheme"
          },
          "when": [
            "button_label",
            "button_link"
          ]
        }
      ],
      "source_defaults": {
        "heading": "@t:sections.image_with_text.heading",
        "button_style": "outline",
        "button_label": "@t:sections.image_with_text.button_label"
      }
    }
  ]
}
