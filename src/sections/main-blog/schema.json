{
  "name": "main-blog",
  "icon": "newspaper",
  "ctx_needs": [
    "blog",
    "blog_category"
  ],
  "settings": [
    {
      "id": "title",
      "type": "text",
      "default": "@t:sections.main_blog.title",
      "editor": {
        "label": "title_fallback",
        "group": "content"
      }
    },
    {
      "id": "fallback_photo",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "opt_photo_auto"
        },
        {
          "value": "room",
          "label": "opt_photo_room"
        },
        {
          "value": "table",
          "label": "opt_photo_table"
        },
        {
          "value": "shelf",
          "label": "opt_photo_shelf"
        },
        {
          "value": "corner",
          "label": "opt_photo_corner"
        },
        {
          "value": "parcel",
          "label": "opt_photo_parcel"
        },
        {
          "value": "linen",
          "label": "opt_photo_linen"
        },
        {
          "value": "bedroom",
          "label": "opt_photo_bedroom"
        },
        {
          "value": "bench",
          "label": "opt_photo_bench"
        },
        {
          "value": "evening",
          "label": "opt_photo_evening"
        },
        {
          "value": "off",
          "label": "opt_photo_none"
        }
      ],
      "editor": {
        "label": "fallback_photo_posts",
        "group": "content"
      }
    },
    {
      "id": "columns",
      "type": "range",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "editor": {
        "label": "columns_desktop",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ]
}
