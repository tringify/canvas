{
  "name": "main-maintenance",
  "icon": "wrench",
  "ctx_needs": [
    "shop",
    "design_mode"
  ],
  "settings": [
    {
      "id": "title",
      "type": "text",
      "default": "@t:sections.main_maintenance.heading",
      "editor": {
        "label": "title",
        "group": "content"
      }
    },
    {
      "id": "message",
      "type": "text",
      "default": "@t:sections.main_maintenance.text",
      "editor": {
        "label": "message",
        "group": "content"
      }
    },
    {
      "id": "auto_check",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "gate_auto_check",
        "group": "content"
      }
    },
    {
      "id": "logo",
      "type": "image",
      "editor": {
        "label": "logo",
        "group": "logo"
      }
    },
    {
      "id": "logo_height",
      "type": "range",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32,
      "editor": {
        "label": "logo_height",
        "group": "logo"
      },
      "visible_if": {
        "setting": "logo",
        "set": true
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "migrations": [
    {
      "id": "heading-to-title",
      "op": "rename_setting",
      "from": {
        "setting": "heading"
      },
      "to": {
        "setting": "title"
      }
    },
    {
      "id": "text-to-message",
      "op": "rename_setting",
      "from": {
        "setting": "text"
      },
      "to": {
        "setting": "message"
      }
    }
  ]
}
