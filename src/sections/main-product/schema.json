{
  "name": "main-product",
  "migrations": [
    {
      "id": "custom-field-to-platform-metafield",
      "op": "rename_block",
      "from_type": "custom_field",
      "to_type": "theme:metafield",
      "source_defaults": {
        "field": "details.material",
        "label": "@t:sections.main_product.custom_field.label"
      }
    }
  ],
  "icon": "package",
  "ctx_needs": [
    "forms",
    "product",
    "product.metafields",
    "routes",
    "csrf_token",
    "customer_settings",
    "restock_notifications",
    "customer.logged_in",
    "customer.email",
    "form_notice",
    "design_mode",
    "phone_countries",
    "localization",
    "shopping",
    "express",
    "breadcrumbs"
  ],
  "settings": [
    {
      "id": "layout",
      "type": "select",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "opt_pdp_classic"
        },
        {
          "value": "stacked",
          "label": "opt_pdp_stacked"
        },
        {
          "value": "thumbs",
          "label": "opt_pdp_thumbs"
        },
        {
          "value": "wide",
          "label": "opt_pdp_wide"
        },
        {
          "value": "focus",
          "label": "opt_pdp_focus"
        }
      ],
      "editor": {
        "label": "page_layout",
        "group": "layout"
      }
    },
    {
      "id": "media_size",
      "type": "select",
      "default": "large",
      "options": [
        {
          "value": "small",
          "label": "opt_small"
        },
        {
          "value": "medium",
          "label": "opt_medium"
        },
        {
          "value": "large",
          "label": "opt_large"
        }
      ],
      "editor": {
        "label": "media_size",
        "group": "layout"
      },
      "visible_if": {
        "setting": "layout",
        "values": [
          "classic",
          "stacked",
          "thumbs"
        ]
      }
    },
    {
      "id": "gallery_layout",
      "type": "select",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "opt_grid"
        },
        {
          "value": "slider",
          "label": "opt_slider_thumbnails"
        },
        {
          "value": "thumbs",
          "label": "opt_gallery_thumbs"
        },
        {
          "value": "stack",
          "label": "opt_gallery_stack"
        }
      ],
      "editor": {
        "label": "gallery_layout",
        "group": "layout"
      },
      "visible_if": {
        "setting": "layout",
        "values": [
          "classic"
        ]
      }
    },
    {
      "id": "media_position",
      "type": "select",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "opt_left"
        },
        {
          "value": "right",
          "label": "opt_right"
        }
      ],
      "editor": {
        "label": "media_position",
        "group": "layout"
      },
      "visible_if": {
        "setting": "layout",
        "values": [
          "classic",
          "stacked",
          "thumbs",
          "focus"
        ]
      }
    },
    {
      "id": "image_ratio",
      "type": "select",
      "default": "natural",
      "options": [
        {
          "value": "natural",
          "label": "opt_image_own_shape"
        },
        {
          "value": "1 / 1",
          "label": "opt_square"
        },
        {
          "value": "4 / 5",
          "label": "opt_portrait"
        },
        {
          "value": "3 / 4",
          "label": "opt_tall"
        },
        {
          "value": "4 / 3",
          "label": "opt_landscape"
        }
      ],
      "editor": {
        "label": "image_ratio",
        "group": "layout"
      }
    },
    {
      "id": "sticky_info",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "sticky_info",
        "group": "layout"
      },
      "visible_if": {
        "setting": "layout",
        "values": [
          "classic",
          "thumbs",
          "wide",
          "focus"
        ]
      }
    },
    {
      "id": "sticky_add_to_cart",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "sticky_add_to_cart",
        "group": "sticky_bar"
      }
    },
    {
      "id": "sticky_bar_screens",
      "type": "select",
      "default": "phones",
      "options": [
        {
          "value": "phones",
          "label": "opt_phones_only"
        },
        {
          "value": "all",
          "label": "opt_all_screens"
        }
      ],
      "editor": {
        "label": "sticky_bar_screens",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_add_to_cart",
        "values": [
          "true"
        ]
      }
    },
    {
      "id": "sticky_bar_picking",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "off",
          "label": "opt_off"
        },
        {
          "value": "auto",
          "label": "opt_picking_auto"
        },
        {
          "value": "sheet",
          "label": "opt_picking_sheet"
        }
      ],
      "editor": {
        "label": "sticky_bar_picking",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_add_to_cart",
        "values": [
          "true"
        ]
      }
    },
    {
      "id": "sticky_bar_inline_max",
      "type": "range",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6,
      "editor": {
        "label": "sticky_bar_inline_max",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_bar_picking",
        "values": [
          "auto"
        ]
      }
    },
    {
      "id": "sticky_bar_quantity",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "sticky_bar_quantity",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_add_to_cart",
        "values": [
          "true"
        ]
      }
    },
    {
      "id": "sticky_bar_wishlist",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "sticky_bar_wishlist",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_add_to_cart",
        "values": [
          "true"
        ]
      }
    },
    {
      "id": "sticky_bar_image",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "sticky_bar_image",
        "group": "sticky_bar"
      },
      "visible_if": {
        "setting": "sticky_add_to_cart",
        "values": [
          "true"
        ]
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "blocks": {
