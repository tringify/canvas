{
  "name": "split-promo",
  "icon": "columns-2",
  "ctx_needs": [
    "design_mode"
  ],
  "settings": [
    {
      "id": "style",
      "type": "select",
      "editor": {
        "label": "style",
        "group": "design"
      },
      "default": "overlay",
      "options": [
        {
          "value": "overlay",
          "label": "opt_text_over_image"
        },
        {
          "value": "below",
          "label": "opt_text_below_image"
        }
      ]
    },
    {
      "id": "image_ratio",
      "type": "select",
      "editor": {
        "label": "image_ratio",
        "group": "layout"
      },
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "opt_square"
        },
        {
          "value": "portrait",
          "label": "opt_portrait"
        },
        {
          "value": "landscape",
          "label": "opt_landscape"
        }
      ]
    },
    {
      "id": "overlay",
      "type": "range",
      "editor": {
        "label": "overlay",
        "group": "design"
      },
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "id": "padding",
      "type": "select",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "opt_spacing_theme"
        },
        {
          "value": "compact",
          "label": "opt_compact"
        },
        {
          "value": "relaxed",
          "label": "opt_relaxed"
        },
        {
          "value": "none",
          "label": "opt_spacing_none"
        }
      ],
      "editor": {
        "label": "section_padding",
        "group": "layout"
      }
    },
    {
      "id": "color_scheme",
      "type": "color_scheme",
      "default": "default",
      "editor": {
        "label": "color_scheme",
        "group": "design"
      }
    }
  ],
  "blocks": {
    "accept_theme_blocks": true,
    "theme_blocks": [
      "split-tile"
    ],
    "max": 2
  },
  "presets": [
    {
      "name": "split-promo",
      "category": "promotion",
      "blocks": [
        {
          "type": "theme:split-tile",
          "settings": {
            "fallback_photo": "corner",
            "blocks": [
              {
                "type": "theme:heading",
                "settings": {
                  "heading": "@t:content.for_the_home"
                }
              },
              {
                "type": "theme:buttons",
                "settings": {
                  "button_label": "@t:sections.promo_grid.tile.button_label"
                }
              }
            ]
          }
        },
        {
          "type": "theme:split-tile",
          "settings": {
            "fallback_photo": "parcel",
            "blocks": [
              {
                "type": "theme:heading",
                "settings": {
                  "heading": "@t:content.gifts_they_keep"
                }
              },
              {
                "type": "theme:buttons",
                "settings": {
                  "button_label": "@t:sections.promo_grid.tile.button_label"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "migrations": [
    {
      "id": "tile-to-theme-block",
      "op": "rename_block",
      "from_type": "tile",
      "to_type": "theme:split-tile"
    }
  ]
}
